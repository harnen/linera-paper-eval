# An environment for building the paper evaluation binaries.
# Contains the OS-level dependencies and the Rust toolchain,
# as well as compiled Linera binaries to set up a network.
# Compiled binaries are copied to /out.
FROM rust:1.95.0-bookworm AS builder

ARG PROTOC_VERSION=21.11
ARG PROTOC_ZIP=protoc-21.11-linux-x86_64.zip
# Fork with the light-client benchmark tool (linera-lite-benchmark). Point this at an exact
# commit hash once it's pushed, rather than the moving branch name, to keep builds
# reproducible -- same reasoning as pinning upstream's LINERA_GIT_REV used to.
ARG LINERA_GIT_URL="https://github.com/harnen/linera-protocol.git"
ARG LINERA_GIT_REV="light_client"

# These are optionally overridden by the build script.
ARG CARGO_PROFILE_FLAG=""
ARG TARGET_DIR="debug"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        curl \
        g++ \
        git \
        libclang-dev \
        libssl-dev \
        make \
        lld \
        pkg-config \
        unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --output "/tmp/${PROTOC_ZIP}" \
        "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/${PROTOC_ZIP}" \
    && unzip "/tmp/${PROTOC_ZIP}" -d /usr/local \
    && rm "/tmp/${PROTOC_ZIP}" \
    && protoc --version

RUN cargo install sccache --locked

ENV RUSTC_WRAPPER=sccache
ENV SCCACHE_DIR=/sccache

WORKDIR /
RUN git clone ${LINERA_GIT_URL} linera-src
WORKDIR /linera-src
RUN git checkout ${LINERA_GIT_REV}

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/sccache \
    cargo build ${CARGO_PROFILE_FLAG} \
    --locked \
    --config profile.release.debug=false \
    --features opentelemetry,metrics \
    -p linera-service \
    --bin linera \
    --bin linera-server \
    --bin linera-proxy \
    --bin linera-lite-benchmark \
    -p linera-storage-service \
    --bin linera-storage-server \
    && mkdir -p /out \
    && cp /linera-src/target/${TARGET_DIR}/linera /out/ \
    && cp /linera-src/target/${TARGET_DIR}/linera-server /out/ \
    && cp /linera-src/target/${TARGET_DIR}/linera-proxy /out/ \
    && cp /linera-src/target/${TARGET_DIR}/linera-lite-benchmark /out/ \
    && cp /linera-src/target/${TARGET_DIR}/linera-storage-server /out/
